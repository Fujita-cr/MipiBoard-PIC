int16_t     ADXL350_Y_Val = 0;
int16_t     ADXL350_Z_Val = 0;


// Average Calc Buffer
uint16_t    ad_arry[10];
uint16_t    sort_arry[10];
uint16_t    ad_val_tmp = 0;
int16_t     tmp102_tmp = 0;
int32_t     tmp102_sum = 0;
int16_t     x_val = 0;
int16_t     y_val = 0;
int16_t     z_val = 0;
int16_t     ADXL350_ari = 0;    //20230605 加速度センサあり

